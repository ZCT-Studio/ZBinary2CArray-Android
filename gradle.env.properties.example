# Copy this file to gradle.env.properties and fill in your signing credentials.
# gradle.env.properties is gitignored — never commit real secrets.

ANDROID_KEYSTORE_FILE=example_release.jks
ANDROID_KEYSTORE_PASSWORD=ANDROID_KEYSTORE_PASSWORD_EXAMPLE
ANDROID_KEY_ALIAS=ANDROID_KEY_ALIAS_EXAMPLE
ANDROID_KEY_PASSWORD=ANDROID_KEY_PASSWORD_EXAMPLE